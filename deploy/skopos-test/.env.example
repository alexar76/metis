# SKOPOS test stack on metis — copy to .env on first deploy (deploy.sh generates secrets).

SKOPOS_POSTGRES_USER=skopos
SKOPOS_POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
SKOPOS_POSTGRES_DB=skopos
SKOPOS_DATABASE_URL=postgresql://skopos:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/skopos

# Bootstrap password (plaintext, legacy). Prefer setting one in the admin panel
# afterwards — it stores only a PBKDF2 hash in the DB and supersedes this value.
SKOPOS_DASHBOARD_PASSWORD=CHANGE_ME_DASHBOARD_PASSWORD
SKOPOS_DASHBOARD_SESSION_HOURS=12
# Fail closed: fleet UI blocked until a password is configured (default on).
SKOPOS_REQUIRE_DASHBOARD_AUTH=1
# Rotate password every N days (default 90; 0 disables). Telegram alert on expiry.
SKOPOS_DASHBOARD_PASSWORD_MAX_AGE_DAYS=90
SKOPOS_SSH_STRICT_HOST_KEYS=1

# GeoIP — default: geojs.io + ipwho.is (free, no account). Optional MaxMind MMDB offline boost.
# MAXMIND_LICENSE_KEY=          # optional — https://www.maxmind.com/en/geolite2/signup
# MAXMIND_ACCOUNT_ID=
# SKOPOS_GEOIP_API_FALLBACK=0   # offline-only when MMDB file is present
# MAXMIND_GEOIP_MAX_AGE_DAYS=14

# Optional LLM keys for Security Agent (leave empty to use rules-only reports)
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# Floating AI assistant — HMAC secret shared by UI + API processes (required in prod).
SKOPOS_AGENT_TOKEN_SECRET=
# Browser Origins allowed to call /agent/* (no wildcard).
SKOPOS_AGENT_CORS_ORIGINS=https://skopos.modelmarket.dev

# AIMarket economy (optional — SKOPOS works standalone when disabled)
SKOPOS_AIMARKET_ENABLED=0
SKOPOS_AIMARKET_PUBLIC_URL=https://skopos.modelmarket.dev
SKOPOS_AIMARKET_API_KEY=
SKOPOS_HUB_URL=
SKOPOS_AIMARKET_AUTO_REGISTER=0
SKOPOS_AIMARKET_PUBLISH_TOKEN=

# Factory Prometheus for Observability page (PromQL). Unset → demo fallback.
# Prefer tunnel / nginx+auth; factory host example:
# SKOPOS_PROMETHEUS_URL=http://5.129.212.122:9090/prometheus

# --- Host agents ------------------------------------------------------------
# Node secrets are HMAC keys, so SKOPOS must be able to read them back. With this
# set they are sealed with AES-GCM under a key held outside the database, so a
# leaked dump is not a set of working fleet credentials. Generate with:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
SKOPOS_NODE_SECRET_KEY=
